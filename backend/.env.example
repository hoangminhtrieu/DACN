# Môi trường cấu hình Urban Plants System

# Application
APP_NAME="Urban Plants API"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
SECRET_KEY="urban-plants-super-secret-jwt-key-replace-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/urban_plants_db"
DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/urban_plants_db"

# Redis Cache
REDIS_URL="redis://localhost:6379/0"

# Firebase Credentials
FIREBASE_CREDENTIALS_PATH="./firebase_service_account.json"
FIREBASE_STORAGE_BUCKET="urban-plants-storage.appspot.com"

# Weather API
OPENWEATHER_API_KEY="mock_openweather_api_key"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "*"]
